{
  "name": "codex-model-switch-tool",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "uv run --locked --managed-python --no-config node scripts/build.mjs",
    "test": "uv run --locked --managed-python --no-config python -m unittest discover -s tests -v && node --test tests/python-runtime.test.mjs",
    "package": "uv run --locked --managed-python --no-config python scripts/package.py",
    "setup:runtime": "node dist/setup-runtime.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.51.0"
  },
  "author": {
    "name": "guoz5658",
    "email": "guoz5658@outlook.com",
    "url": "https://github.com/scofield5658"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/scofield5658/codex-model-switch-tool.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
